        self.on_init()



    def _declare_nos_parameters(self):
        pass

    def _setup_communications(self):
        self._scan_sub = self.create_subscription(
            LaserScan, "/scan", self._on_scan_received, create_qos_profile(reliability='reliable', depth=5)
        )

        self.cmd = self.create_publisher(
            Twist, "/cmd_vel", 10
        )

        self._trigger_srv = self.create_service(
            Trigger, "/trigger", self._trigger_callback
        )

        self._fib_action_server = ActionServer(
            self, Fibonacci, 'fib',
            execute_callback=self._on_fib_execute
        )

    def _on_scan_received(self, msg: LaserScan):
        """Wrapper for scan subscription callback."""
        try:
            self.scan_received(msg)
        except Exception as e:
            self.get_logger().error(f"Error in scan callback: {e}")

    def _trigger_callback(self, request, response):
        """Wrapper for trigger service callback."""
        try:
            return self.trigger_request(request, response)
        except Exception as e:
            self.get_logger().error(f"Error in trigger service: {e}")
            response.success = False
            return response


    def trigger_request(self, request, response):
        """Default implementation for trigger requests."""
        response.success = True
        return response

    def _on_fib_execute(self, goal_handle):
        """Wrapper for fib action execute callback."""
        try:
            return self.fib_execute(goal_handle)
        except Exception as e:
            self.get_logger().error(f"Error in fib action execute callback: {e}")
            goal_handle.abort()
            return Fibonacci.Result()


    def fib_execute(self, goal_handle):
        """Default implementation for fib action execution."""
        goal_handle.succeed()
        return Fibonacci.Result()

    def scan_received(self, msg: LaserScan):
        """User callback: scan_received."""
        try:
            self.get_logger().info("got scan")
        except Exception as e:
            self.get_logger().error(f"Error in scan_received callback: {e}")
            raise  # Re-raise to allow upstream handling





